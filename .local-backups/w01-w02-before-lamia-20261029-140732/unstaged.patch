+            throw new ResponseStatusException(HttpStatus.UNAUTHORIZED);
+        }
+        var store = ownedActivities.orElseThrow(() ->
+                new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE));
+        return store.save(request, owner.id());
     }
